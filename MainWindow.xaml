<Window x:Class="Parrandachilik.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Parrandachilik Buxgalteriyasi" Height="750" Width="1350" Loaded="Window_Loaded">

    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Background="#F0F0F0" Height="45" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock Text="Тил:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="cmbLanguage" Width="180" Height="28" SelectionChanged="CmbLanguage_SelectionChanged">
                    <ComboBoxItem Content="Ўзбекча (Кирилл)" Tag="uz" IsSelected="True"/>
                    <ComboBoxItem Content="Русский (Кириллица)" Tag="ru"/>
                </ComboBox>
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="🏠 Asosiy" Padding="8,2" Margin="2" Click="MenuButton_Click" Tag="0" />
                <Button Content="🏭 Ishlab chiqarish" Padding="8,2" Margin="2" Click="MenuButton_Click" Tag="1" />
                <Button Content="🌾 Yem Ombor" Padding="8,2" Margin="2" Click="MenuButton_Click" Tag="2"/>
                <Button Content="🥚 Tuxum Ombor" Padding="8,2" Margin="2" Click="MenuButton_Click" Tag="3"/>
                <Button Content="🐔 Parranda" Padding="8,2" Margin="2" Click="MenuButton_Click" Tag="4"/>
                <Button Content="💩 Gung" Padding="8,2" Margin="2" Click="MenuButton_Click" Tag="5"/>
                <Button Content="💰 Kassa" Padding="8,2" Margin="2" Click="MenuButton_Click" Tag="6"/>
                <Button Content="🛍️ Sotish" Padding="8,2" Margin="2" Click="MenuButton_Click" Tag="7"/>
                <Button Content="🛒 Xarid" Padding="8,2" Margin="2" Click="MenuButton_Click" Tag="8"/>
                <Button Content="💸 Ish haqi" Padding="8,2" Margin="2" Click="MenuButton_Click" Tag="9"/>
                <Button Content="📊 Hisobot" Padding="8,2" Margin="2" Click="MenuButton_Click" Tag="10"/>
                <Button Content="📈 Statistika" Padding="8,2" Margin="2" Click="MenuButton_Click" Tag="11"/>
                <Button Content="⚙️ Sozlamalar" Padding="8,2" Margin="2" Click="MenuButton_Click" Tag="12"/>
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="mainTabControl" BorderThickness="0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Asosiy">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Margin="5" Padding="10" Background="#FFF8E1" CornerRadius="8" BorderBrush="#FFD54F" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="1 boshga yem sarfi" FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtKpiYemSarfi" Text="0.00 kg" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Margin="5" Padding="10" Background="#E8F5E9" CornerRadius="8" BorderBrush="#81C784" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Tuxum berish foizi" FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtKpiTuxumFoiz" Text="0.00 %" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="2" Margin="5" Padding="10" Background="#FFEBEE" CornerRadius="8" BorderBrush="#E57373" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Nobud bo'lish foizi" FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtKpiNobudFoiz" Text="0.00 %" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="3" Margin="5" Padding="10" Background="#E3F2FD" CornerRadius="8" BorderBrush="#64B5F6" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Kunlik sof foyda" FontWeight="SemiBold"/>
                            <TextBlock x:Name="txtKpiSofFoyda" Text="0.00 so'm" FontSize="18" FontWeight="Bold" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Header="Statuslar" Margin="5,8,5,5">
                        <StackPanel Orientation="Horizontal" Margin="8">
                            <TextBlock Text="Kutilmoqda:" VerticalAlignment="Center"/>
                            <Border Background="#FFD54F" CornerRadius="10" Margin="6,0,16,0" Padding="8,2">
                                <TextBlock x:Name="txtStatusSariq" Text="0" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="Qabul qilindi:" VerticalAlignment="Center"/>
                            <Border Background="#81C784" CornerRadius="10" Margin="6,0,16,0" Padding="8,2">
                                <TextBlock x:Name="txtStatusYashil" Text="0" FontWeight="Bold"/>
                            </Border>
                            <TextBlock Text="Qaytarildi:" VerticalAlignment="Center"/>
                            <Border Background="#EF9A9A" CornerRadius="10" Margin="6,0,16,0" Padding="8,2">
                                <TextBlock x:Name="txtStatusQizil" Text="0" FontWeight="Bold"/>
                            </Border>
                            <Button Content="KPI yangilash" Click="BtnRefreshDashboard_Click" Margin="10,0,0,0" Padding="10,3"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Header="Tezkor amallar" Margin="5">
                        <StackPanel Orientation="Horizontal" Margin="8">
                            <Button Content="➕ Yangi kiritma" Width="160" Margin="0,0,10,0" Click="BtnAddTuxum_Click"/>
                            <Button Content="📤 Omborga yuborish" Width="170" Margin="0,0,10,0"/>
                            <Button Content="✅ Qabulni tekshirish" Width="170" Click="MenuButton_Click" Tag="3"/>
                        </StackPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Ishlab chiqarish">
                <TabControl Margin="10">
                    <TabItem Header="Tuxum kiritish">
                        <DockPanel Margin="5">
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Sex:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox x:Name="cmbIshlabSex" Width="120" DisplayMemberPath="Nomi" SelectionChanged="CmbIshlabSex_SelectionChanged"/>
                                <TextBlock Text="Yarus:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <ComboBox x:Name="cmbIshlabYarus" Width="120" DisplayMemberPath="Nomi"/>
                                <TextBlock Text="Hodim:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <ComboBox x:Name="cmbIshlabHodim" Width="180" DisplayMemberPath="FISH" IsEditable="True" IsTextSearchEnabled="True"/>
                                <TextBlock Text="Parranda:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <TextBox x:Name="txtIshlabParrandaSoni" Width="70" Text="2000"/>
                                <TextBlock Text="Nobud:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <TextBox x:Name="txtIshlabNobudSoni" Width="50" Text="0"/>
                                <TextBlock Text="Yem kg:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <TextBox x:Name="txtIshlabYemKg" Width="60" Text="250"/>
                                <TextBlock Text="1.6:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <TextBox x:Name="txtIshlabW16" Width="50" Text="0"/>
                                <TextBlock Text="1.7:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <TextBox x:Name="txtIshlabW17" Width="50" Text="0"/>
                                <TextBlock Text="1.8:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <TextBox x:Name="txtIshlabW18" Width="50" Text="0"/>
                                <TextBlock Text="1.9:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <TextBox x:Name="txtIshlabW19" Width="50" Text="0"/>
                                <TextBlock Text="2.0:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <TextBox x:Name="txtIshlabW20" Width="50" Text="0"/>
                                <TextBlock Text="2.5:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <TextBox x:Name="txtIshlabW25" Width="50" Text="0"/>
                                <TextBlock Text="Siniq:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <TextBox x:Name="txtIshlabSiniq" Width="50" Text="0"/>
                                <TextBlock Text="Paket:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <TextBox x:Name="txtIshlabPaket" Width="50" Text="0"/>
                                <Button Content="➕ Yangi kiritish" Click="BtnAddTuxum_Click" Width="150" />
                                <Button Content="🔄 Yangilash" Click="BtnRefreshTuxum_Click" Margin="10,0,0,0"/>
                            </WrapPanel>
                            <DataGrid x:Name="dgIshlabChiqarish" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" Background="White">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="White"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tasdiqlash}" Value="Kutilmoqda">
                                                <Setter Property="Background" Value="#FFF9C4"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tasdiqlash}" Value="Qabul qilindi">
                                                <Setter Property="Background" Value="#E8F5E9"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tasdiqlash}" Value="Qaytarildi">
                                                <Setter Property="Background" Value="#FFEBEE"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="40"/>
                                    <DataGridTextColumn Header="Sex Nomi" Binding="{Binding SexNomi}" Width="100"/>
                                    <DataGridTextColumn Header="Sana" Binding="{Binding Sana}" Width="80"/>
                                    <DataGridTextColumn Header="Hodim FISH" Binding="{Binding HodimFISH}" Width="120"/>
                                    <DataGridTextColumn Header="1,6 kg" Binding="{Binding W1_6}" Width="60"/>
                                    <DataGridTextColumn Header="1,7 kg" Binding="{Binding W1_7}" Width="60"/>
                                    <DataGridTextColumn Header="1,8 kg" Binding="{Binding W1_8}" Width="60"/>
                                    <DataGridTextColumn Header="1,9 kg" Binding="{Binding W1_9}" Width="60"/>
                                    <DataGridTextColumn Header="2,0 kg" Binding="{Binding W2_0}" Width="60"/>
                                    <DataGridTextColumn Header="2,5 kg" Binding="{Binding W2_5}" Width="60"/>
                                    <DataGridTextColumn Header="Siniq" Binding="{Binding Siniq}" Width="60"/>
                                    <DataGridTextColumn Header="Paket" Binding="{Binding Paket}" Width="60"/>
                                    <DataGridTextColumn Header="Holat" Binding="{Binding Tasdiqlash}" Width="100" FontWeight="Bold"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Juja sexidan kelim">
                        <DockPanel Margin="5">
                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Sex:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <ComboBox x:Name="cmbJujaSex" Width="120" DisplayMemberPath="Nomi" SelectionChanged="CmbJujaSex_SelectionChanged"/>
                                <TextBlock Text="Yarus:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <ComboBox x:Name="cmbJujaYarus" Width="120" DisplayMemberPath="Nomi"/>
                                <TextBlock Text="Sana:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <DatePicker x:Name="dpJujaSana" Width="120"/>
                                <TextBlock Text="Kelgan:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <TextBox x:Name="txtJujaKelganSoni" Width="70" Text="0"/>
                                <TextBlock Text="Kasal:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <TextBox x:Name="txtJujaKasalSoni" Width="70" Text="0"/>
                                <TextBlock Text="Nobud:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <TextBox x:Name="txtJujaNobudSoni" Width="70" Text="0"/>
                                <TextBlock Text="Izoh:" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <TextBox x:Name="txtJujaIzoh" Width="220"/>
                                <Button Content="➕ Saqlash" Margin="10,0,0,0" Click="BtnAddJujaKirim_Click"/>
                            </WrapPanel>
                            <DataGrid x:Name="dgJujaKirimlar" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" Background="White">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sana" Binding="{Binding Sana}" Width="90"/>
                                    <DataGridTextColumn Header="Sex" Binding="{Binding SexNomi}" Width="90"/>
                                    <DataGridTextColumn Header="Yarus" Binding="{Binding YarusNomi}" Width="90"/>
                                    <DataGridTextColumn Header="Kelgan" Binding="{Binding KelganSoni}" Width="90"/>
                                    <DataGridTextColumn Header="Kasal" Binding="{Binding KasalSoni}" Width="90"/>
                                    <DataGridTextColumn Header="Nobud" Binding="{Binding NobudSoni}" Width="90"/>
                                    <DataGridTextColumn Header="Sog'lom" Binding="{Binding SoglomQoldi}" Width="90" FontWeight="Bold"/>
                                    <DataGridTextColumn Header="Izoh" Binding="{Binding Izoh}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </TabItem>

            <TabItem Header="Yem Ombor">
                <TextBlock Text="Yem" Margin="10"/>
            </TabItem>

            <TabItem Header="Tuxum Ombor">
                <DockPanel Margin="10">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Sana dan:" VerticalAlignment="Center" Margin="0,0,5,0" FontWeight="SemiBold"/>
                        <DatePicker x:Name="dpSanaDan" Width="110" SelectedDateChanged="DpOmborFilterDate_SelectedDateChanged"/>
                        <TextBlock Text="gacha:" VerticalAlignment="Center" Margin="10,0,5,0" FontWeight="SemiBold"/>
                        <DatePicker x:Name="dpSanaGacha" Width="110" SelectedDateChanged="DpOmborFilterDate_SelectedDateChanged"/>
                        <Button Content="🔍 Filtr" Click="BtnFilter_Click" Background="#E0E0E0" Padding="10,0" Margin="5,0,15,0" Cursor="Hand"/>
                        <Button Content="✅ Tasdiqlash" Click="BtnApprove_Click" Background="LightGreen" Padding="10,5" />
                        <Button Content="❌ Qaytarish" Click="BtnReject_Click" Background="LightPink" Padding="10,5" Margin="10,0,0,0"/>
                        <Button Content="Excelga chiqarish" Click="BtnExportToExcel_Click" Background="#007ACC" Foreground="White" Padding="10,5" Margin="10,0,0,0" Cursor="Hand"/>
                        <Button Content="🖨 A4 chiqarish" Click="BtnPrintOmborA4_Click" Background="#455A64" Foreground="White" Padding="10,5" Margin="10,0,0,0" Cursor="Hand"/>
                        <Button Content="🔄" Click="BtnRefreshOmbor_Click" Width="35" Margin="10,0,0,0" Background="#E0E0E0" ToolTip="Yangilash" Cursor="Hand"/>
                    </StackPanel>
                    <DataGrid x:Name="dgOmbor" AutoGenerateColumns="False" SelectionMode="Single" GridLinesVisibility="All" HorizontalGridLinesBrush="LightGray" VerticalGridLinesBrush="LightGray" RowHeight="30" Background="White">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Tasdiqlash}" Value="Kutilmoqda">
                                        <Setter Property="Background" Value="#FFF9C4"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tasdiqlash}" Value="Qabul qilindi">
                                        <Setter Property="Background" Value="#E8F5E9"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Tasdiqlash}" Value="Qaytarildi">
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="!" Width="30">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="●" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="Transparent" ToolTip="{Binding QaytarishIzoh}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tasdiqlash}" Value="Qaytarildi">
                                                            <Setter Property="Foreground" Value="#D32F2F"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="ID" Binding="{Binding ID}" Width="40"/>
                            <DataGridTextColumn Header="Sex Nomi" Binding="{Binding SexNomi}" Width="100"/>
                            <DataGridTextColumn Header="Sana" Binding="{Binding Sana}" Width="80"/>
                            <DataGridTextColumn Header="Hodim FISH" Binding="{Binding HodimFISH}" Width="120"/>
                            <DataGridTextColumn Header="1,6 kg" Binding="{Binding W1_6}" Width="60"/>
                            <DataGridTextColumn Header="1,7 kg" Binding="{Binding W1_7}" Width="60"/>
                            <DataGridTextColumn Header="1,8 kg" Binding="{Binding W1_8}" Width="60"/>
                            <DataGridTextColumn Header="1,9 kg" Binding="{Binding W1_9}" Width="60"/>
                            <DataGridTextColumn Header="2,0 kg" Binding="{Binding W2_0}" Width="60"/>
                            <DataGridTextColumn Header="2,5 kg" Binding="{Binding W2_5}" Width="60"/>
                            <DataGridTextColumn Header="Siniq" Binding="{Binding Siniq}" Width="60"/>
                            <DataGridTextColumn Header="Paket" Binding="{Binding Paket}" Width="60"/>
                            <DataGridTextColumn Header="Tasdiqlash Holati" Binding="{Binding Tasdiqlash}" FontWeight="Bold"/>
                            <DataGridTextColumn Header="Qaytarish izohi" Binding="{Binding QaytarishIzoh}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Parranda">
                <TextBlock Text="Parranda" Margin="10" />
            </TabItem>
            <TabItem Header="Gung">
                <TextBlock Text="Gung" Margin="10"/>
            </TabItem>
            <TabItem Header="Kassa">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <GroupBox Grid.Row="0" Grid.ColumnSpan="2" Header="Kunlik kassa holati" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="8">
                            <TextBlock Text="Sana:" VerticalAlignment="Center"/>
                            <DatePicker x:Name="dpKassaSana" Width="120" Margin="6,0,12,0" SelectedDateChanged="DpKassaSana_SelectedDateChanged"/>
                            <TextBlock Text="Kun boshi:" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtKassaKunBoshi" Width="110" Margin="6,0,12,0" TextChanged="TxtKassaHisob_TextChanged"/>
                            <TextBlock Text="Kirim:" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtKassaKirimJami" Width="110" Margin="6,0,12,0" IsReadOnly="True"/>
                            <TextBlock Text="Rashod:" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtKassaRashodJami" Width="110" Margin="6,0,12,0" IsReadOnly="True"/>
                            <TextBlock Text="Kun oxiri:" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="txtKassaKunOxiri" Width="120" Margin="6,0,0,0" IsReadOnly="True" FontWeight="Bold" Background="#E8F5E9"/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Grid.Column="0" Header="Kirim (Sotuvdan naqd tushum)" Margin="0,0,8,0">
                        <DockPanel Margin="8">
                            <Button Content="✅ Kassa qabul qildi" DockPanel.Dock="Top" Margin="0,0,0,8" Click="BtnKassaQabul_Click"/>
                            <DataGrid x:Name="dgKassaKirim" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Chek" Binding="{Binding ChekID}" Width="50"/>
                                    <DataGridTextColumn Header="Sana" Binding="{Binding Sana}" Width="90"/>
                                    <DataGridTextColumn Header="Klent" Binding="{Binding Mijoz}" Width="*"/>
                                    <DataGridTextColumn Header="Naqd" Binding="{Binding Naqd, StringFormat=N0}" Width="90"/>
                                    <DataGridTextColumn Header="Holat" Binding="{Binding Holat}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Grid.Column="1" Header="Rashodlar" Margin="8,0,0,0">
                        <DockPanel Margin="8">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <ComboBox x:Name="cmbKassaRashodTuri" Width="190" Margin="0,0,6,0" ToolTip="Harajat turi" SelectionChanged="CmbKassaRashodTuri_SelectionChanged"/>
                                <TextBox x:Name="txtKassaRashodKimga" Width="140" Margin="0,0,4,0" ToolTip="Kimga" IsReadOnly="True" Background="#F5F5F5"/>
                                <Button Content="..." Width="28" Margin="0,0,6,0" Click="BtnKassaKimgaMenu_Click" ToolTip="Kimga tanlash"/>
                                <TextBox x:Name="txtKassaRashodIzoh" Width="170" Margin="0,0,6,0" ToolTip="To'lov tafsiloti"/>
                                <TextBox x:Name="txtKassaRashodSumma" Width="90" Margin="0,0,6,0" ToolTip="Summa"/>
                                <Button Content="+ Qo'shish" Width="90" Margin="0,0,6,0" Click="BtnKassaRashodAdd_Click"/>
                                <Button Content="🖨 Print" Width="80" Margin="0,0,6,0" Click="BtnKassaRashodPrint_Click"/>
                                <Button Content="🗑 O'chirish" Width="90" Click="BtnKassaRashodDelete_Click"/>
                            </StackPanel>
                            <Popup x:Name="popKassaKimgaMenu" PlacementTarget="{Binding ElementName=txtKassaRashodKimga}" StaysOpen="False" AllowsTransparency="True">
                                <Border Background="White" BorderBrush="Gray" BorderThickness="1" Padding="6" Width="380" Height="260">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="Qidirish:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox x:Name="txtPopupKassaKimgaFilter" Width="240" Height="24" TextChanged="TxtPopupKassaKimgaFilter_TextChanged"/>
                                        </StackPanel>
                                        <DataGrid x:Name="dgPopupKassaKimga" AutoGenerateColumns="False" IsReadOnly="True" MouseDoubleClick="DgPopupKassaKimga_MouseDoubleClick">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Nomi" Binding="{Binding Nomi}" Width="*"/>
                                                <DataGridTextColumn Header="Manba" Binding="{Binding Manba}" Width="110"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </DockPanel>
                                </Border>
                            </Popup>
                            <DataGrid x:Name="dgKassaRashod" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="№" Binding="{Binding Raqam}" Width="85"/>
                                    <DataGridTextColumn Header="Sana" Binding="{Binding Sana}" Width="90"/>
                                    <DataGridTextColumn Header="Harajat turi" Binding="{Binding Turi}" Width="150"/>
                                    <DataGridTextColumn Header="Kimga" Binding="{Binding Kimga}" Width="130"/>
                                    <DataGridTextColumn Header="Tafsilot" Binding="{Binding Izoh}" Width="*"/>
                                    <DataGridTextColumn Header="Summa" Binding="{Binding Summa, StringFormat=N0}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem Header="Sotish">
                <DockPanel Margin="5">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,5">
                        <Ellipse x:Name="elQizil" Width="15" Height="15" Fill="LightGray" Margin="5"/>
                        <Ellipse x:Name="elSariq" Width="15" Height="15" Fill="LightGray" Margin="5"/>
