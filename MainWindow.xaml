                </TabControl>
            </TabItem>
            <TabItem Header="Statistika">
                <TextBlock Text="Statistika" Margin="10"/>
            </TabItem>

            <TabItem Header="⚙️ Sozlamalar">
                <TabControl TabStripPlacement="Top" Background="#F9F9F9" Margin="5">
                    <TabControl.Resources>
                        <Style TargetType="TabItem">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="Padding" Value="10,5"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Style>
                    </TabControl.Resources>

                    <TabItem Header="Mijozlar">
                        <DockPanel Margin="10">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Mijoz qo'shish" FontWeight="Bold" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="txtSozlamaMijozNomi" Width="200" Padding="5" ToolTip="Mijoz nomi (F.I.SH)"/>
                                    <TextBox x:Name="txtSozlamaMijozTel" Width="120" Padding="5" Margin="5,0,0,0" ToolTip="Telefon (+998...)"/>
                                    <TextBox x:Name="txtSozlamaMijozManzil" Width="200" Padding="5" Margin="5,0,0,0" ToolTip="Manzili"/>
                                    <DatePicker x:Name="dpMijozSana" Width="120" Margin="5,0,0,0" ToolTip="Shartnoma sanasi"/>
                                    <TextBox x:Name="txtMijozShartnomaNo" Width="80" Padding="5" Margin="5,0,0,0" ToolTip="Shartnoma №"/>
                                    <Button Content="➕ Saqlash" Click="BtnAddMijoz_Click" Margin="10,0,0,0" Padding="15,0" Background="LightGreen" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                            <DataGrid x:Name="dgSozlamaMijozlar" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" Background="White" RowHeight="25">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Mijoz (Korrespondent)" Binding="{Binding Nomi}" Width="*"/>
                                    <DataGridTextColumn Header="Telefon" Binding="{Binding Tel}" Width="120"/>
                                    <DataGridTextColumn Header="Manzil" Binding="{Binding Manzil}" Width="200"/>
                                    <DataGridTextColumn Header="Shartnoma Sana" Binding="{Binding ShartnomaSana}" Width="100"/>
                                    <DataGridTextColumn Header="Shartnoma №" Binding="{Binding ShartnomaRaqami}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Pudratchilar">
                        <DockPanel Margin="10">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Pudratchi (Taminotchi) qo'shish" FontWeight="Bold" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="txtPudratchiNomi" Width="200" Padding="5" ToolTip="Tashkilot nomi"/>
                                    <TextBox x:Name="txtPudratchiTel" Width="120" Padding="5" Margin="5,0,0,0" ToolTip="Telefon"/>
                                    <TextBox x:Name="txtPudratchiManzil" Width="200" Padding="5" Margin="5,0,0,0" ToolTip="Manzil"/>
                                    <DatePicker x:Name="dpPudratchiSana" Width="120" Margin="5,0,0,0" ToolTip="Shartnoma sanasi"/>
                                    <TextBox x:Name="txtPudratchiShartnomaNo" Width="80" Padding="5" Margin="5,0,0,0" ToolTip="Shartnoma №"/>
                                    <Button Content="➕ Saqlash" Click="BtnAddPudratchi_Click" Margin="10,0,0,0" Padding="15,0" Background="LightGreen" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                            <DataGrid x:Name="dgSozlamaPudratchilar" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" Background="White" RowHeight="25">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Pudratchi Nomi" Binding="{Binding Nomi}" Width="*"/>
                                    <DataGridTextColumn Header="Telefon" Binding="{Binding Tel}" Width="120"/>
                                    <DataGridTextColumn Header="Manzil" Binding="{Binding Manzil}" Width="200"/>
                                    <DataGridTextColumn Header="Shartnoma Sana" Binding="{Binding ShartnomaSana}" Width="100"/>
                                    <DataGridTextColumn Header="Shartnoma №" Binding="{Binding ShartnomaRaqami}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Xodimlar">
                        <DockPanel Margin="10">
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Xodim qo'shish" FontWeight="Bold" Margin="0,0,0,5"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox x:Name="txtHodimFISH" Width="250" Padding="5" ToolTip="F.I.SH"/>
                                    <TextBox x:Name="txtHodimTel" Width="150" Padding="5" Margin="5,0,0,0" ToolTip="Telefon"/>
                                    <DatePicker x:Name="dpHodimSana" Width="150" Margin="5,0,0,0" ToolTip="Mehnat shartnoma sanasi"/>
                                    <Button Content="➕ Saqlash" Click="BtnAddHodim_Click" Margin="10,0,0,0" Padding="15,0" Background="LightGreen" FontWeight="Bold"/>
                                </StackPanel>
                            </StackPanel>
                            <DataGrid x:Name="dgSozlamaHodimlar" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All" Background="White" RowHeight="25">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="F.I.SH" Binding="{Binding FISH}" Width="*"/>
                                    <DataGridTextColumn Header="Telefon" Binding="{Binding Tel}" Width="150"/>
                                    <DataGridTextColumn Header="Shartnoma Sanasi" Binding="{Binding ShartnomaSana}" Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Xomashyo">
                        <DockPanel Margin="10">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox x:Name="txtHomAshyoNomi" Width="250" Padding="5" ToolTip="Xomashyo nomi"/>
                                <Button Content="➕ Saqlash" Click="BtnAddHomAshyo_Click" Margin="10,0,0,0" Padding="15,0" Background="LightGreen"/>
                            </StackPanel>
                            <DataGrid x:Name="dgSozlamaHomAshyo" AutoGenerateColumns="True" IsReadOnly="True" Background="White" RowHeight="25"/>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Tayyor Mahsulot">
                        <DockPanel Margin="10">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox x:Name="txtTayyorMahsulotNomi" Width="250" Padding="5" ToolTip="Mahsulot nomi (1.6 kg, Nuri ...)"/>
                                <Button Content="➕ Saqlash" Click="BtnAddTayyorMahsulot_Click" Margin="10,0,0,0" Padding="15,0" Background="LightGreen"/>
                            </StackPanel>
                            <DataGrid x:Name="dgSozlamaTayyorMahsulot" AutoGenerateColumns="True" IsReadOnly="True" Background="White" RowHeight="25"/>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="O'lchov birligi">
                        <DockPanel Margin="10">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBox x:Name="txtOlchovNomi" Width="150" Padding="5" ToolTip="Dona, kg, litr ..."/>
                                <Button Content="➕ Saqlash" Click="BtnAddOlchov_Click" Margin="10,0,0,0" Padding="15,0" Background="LightGreen"/>
                            </StackPanel>
                            <DataGrid x:Name="dgSozlamaOlchov" AutoGenerateColumns="True" IsReadOnly="True" Background="White" RowHeight="25"/>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Valyuta">
                        <StackPanel Margin="10" Width="360">
                            <TextBlock Text="Milliy bank USD kursi" FontWeight="SemiBold"/>
                            <TextBox x:Name="txtSozlamaBankKursi" Margin="0,5,0,8" Padding="6"/>
                            <Button Content="Kursni saqlash" Width="140" Click="BtnSaveBankKursi_Click"/>
                        </StackPanel>
                    </TabItem>

                    <TabItem Header="Sexlar">
                        <DockPanel Margin="10">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBox x:Name="txtSexNomiKatalog" Width="220" Padding="5" ToolTip="Sex nomi"/>
                                <Button Content="➕ Sex qo'shish" Margin="8,0,0,0" Click="BtnAddSex_Click"/>
                            </StackPanel>
                            <DataGrid x:Name="dgSozlamaSexlar" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sex nomi" Binding="{Binding Nomi}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="Yaruslar">
                        <DockPanel Margin="10">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <ComboBox x:Name="cmbYarusSexTanlash" Width="180" DisplayMemberPath="Nomi"/>
                                <TextBox x:Name="txtYarusNomiKatalog" Width="180" Padding="5" Margin="8,0,0,0" ToolTip="Yarus nomi"/>
                                <Button Content="➕ Yarus qo'shish" Margin="8,0,0,0" Click="BtnAddYarus_Click"/>
                            </StackPanel>
                            <DataGrid x:Name="dgSozlamaYaruslar" AutoGenerateColumns="False" IsReadOnly="True" GridLinesVisibility="All">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sex" Binding="{Binding SexNomi}" Width="180"/>
                                    <DataGridTextColumn Header="Yarus nomi" Binding="{Binding Nomi}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>

                </TabControl>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>